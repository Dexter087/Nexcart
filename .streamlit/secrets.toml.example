# Streamlit Community Cloud secrets example.
# Do NOT commit a real .streamlit/secrets.toml file with your password.
# In Streamlit Cloud, paste these values into App settings > Secrets.

DB_HOST = "YOUR_NEON_HOST"
DB_PORT = "5432"
DB_NAME = "YOUR_DATABASE_NAME"
DB_USER = "YOUR_DATABASE_USER"
DB_PASSWORD = "YOUR_DATABASE_PASSWORD"
DB_SSLMODE = "require"

# Alternative: instead of the individual fields above, you can use one full URL.
# DATABASE_URL = "postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
